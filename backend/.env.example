# Copy to .env and fill in your own values. Never commit the real .env.
#
# Without PLAYHEAD_API_KEY set, every endpoint is open to anyone who can
# reach this server -- fine for a localhost demo, never for anything
# reachable over a network. Set the SAME value here, in the environment
# that runs playhead-sync, and as VITE_API_KEY in frontend/.env.
PLAYHEAD_API_KEY=

# Comma-separated list of origins allowed to call this API. Defaults to the
# local Vite dev ports if unset -- override for any real deployment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Defaults to a local SQLite file. Point at Postgres for anything beyond
# solo local use -- SQLite has no encryption-at-rest of its own, and a
# managed Postgres provider gives you that (and TLS in transit) for free.
DATABASE_URL=
